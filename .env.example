# Obserwator configuration (Nogat DEV-18). Copy this file to .env and adjust values.
#
# A setting comes from the first of: the command-line option, the variable
# OBSERWATOR_<KEY> in the environment, the same variable in .env, NOGAT_<KEY> (only
# data_dir, cache_dir, state_dir and lang), the section [obserwator] and then [nogat] of
# nogat.toml (key = the variable without OBSERWATOR_, lower case), the default.
# nogat.toml lives in the user configuration directory (for example
# ~/.config/nogat/nogat.toml) or at the path in NOGAT_CONFIG. Credentials
# (OBSERWATOR_STORE_WRITE_TOKEN) are read from the environment only, never from
# nogat.toml. `obserwator config show --json` lists every value and where it comes from.

# --- Shared with the other tools (also NOGAT_DATA_DIR, NOGAT_CACHE_DIR, NOGAT_STATE_DIR,
# NOGAT_LANG)
# Parent directory of the stores (<data_dir>/obserwator, <data_dir>/obserwator-raw), of
# the REST API keys and of the GUI's statistics and reports (stats.jsonl, feedback.jsonl).
# Default: the user data directory of nogat (for example ~/.local/share/nogat).
# Until 3.0.0 IMGW_DATA_DIR held the reference data: that is OBSERWATOR_REFERENCE_DIR now.
# OBSERWATOR_DATA_DIR=
# Caches (<cache_dir>/obserwator). Default: the user cache directory of nogat.
# OBSERWATOR_CACHE_DIR=
# State kept between runs: the logs of `obserwator server` and `obserwator gui serve`,
# <state_dir>/obserwator/logs/<kind>-YYYY-MM-DD.jsonl (access, app, lifecycle), which
# the servers delete after 14 days (Nogat DEV-12.6). Default: the user state directory
# of nogat (for example ~/.local/state/nogat).
# OBSERWATOR_STATE_DIR=
# Language of the human-readable output of the CLI (help, progress and notice lines):
# pl or en. Machine output (--json, AGENTS.md, the MCP server) stays English.
OBSERWATOR_LANG=pl

# --- Reference data of IMGW-PIB (python -m obserwator.reference_data)
# Default: <cache_dir>/obserwator/reference
# OBSERWATOR_REFERENCE_DIR=

# --- REST server (obserwator server)
# Environment: development, production
OBSERWATOR_ENV=development
OBSERWATOR_HOST=0.0.0.0
OBSERWATOR_PORT=8000
# The servers log at fixed levels (Nogat DEV-12.7): no log-level setting; their
# warnings and errors go to <state_dir>/obserwator/logs/app-YYYY-MM-DD.jsonl.
# File of the REST API keys of `obserwator admin` (default: <data_dir>/obserwator/api_keys.json)
# OBSERWATOR_API_KEYS_FILE=
# Rate limiting (requests per hour per key, 0 = unlimited)
OBSERWATOR_RATE_LIMIT=100
# Default and maximum page size of REST list commands
OBSERWATOR_API_MAX_LIMIT=1000

# --- Store roots (DEV-19.2, ADR-017): the defaults for the CLI, the library and
# `obserwator mcp`, and the only roots of the REST server.
# Data root (series, station catalogs, analyses): the default of --root
# (else <data_dir>/obserwator)
# OBSERWATOR_ROOT=/srv/obserwator
# Raw root (downloaded archives, station sources, PMAXTP cells): the default of --root of
# the raw commands and of --raw-root of series build and store catalog
# (else <data_dir>/obserwator-raw)
# OBSERWATOR_RAW_ROOT=/srv/obserwator-raw
OBSERWATOR_STORE_WRITES_ENABLED=false
# Credential: token of REST writes (header X-API-Key); environment only
# OBSERWATOR_STORE_WRITE_TOKEN=
# Directory of user station-location CSVs offered to the REST routes by file name
# OBSERWATOR_USER_LOCATIONS_DIR=

# --- MCP (extra obserwator[mcp])
# Serve MCP over Streamable HTTP at /mcp in `obserwator server` (read and plan only)
OBSERWATOR_MCP_ENABLED=false
# Host names answered by /mcp (comma-separated, with or without a port)
OBSERWATOR_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Start `obserwator mcp` in the write mode (writing tools still plan unless check=false)
OBSERWATOR_MCP_ALLOW_WRITES=false

# --- Web GUI (obserwator gui serve; extras obserwator[cli,gui])
# Basemap: a TileJSON drawn in the GUI's own style; the TileJSON and its tiles must share
# one origin, the only remote one the page may reach. "none" or "off": no basemap, the
# packaged borders of Poland and Czechia (offline). An empty value means the same only in
# the environment: .env ignores empty values.
OBSERWATOR_GUI_BASEMAP_URL=https://tiles.openfreemap.org/planet
OBSERWATOR_GUI_BASEMAP_ATTRIBUTION="OpenFreeMap © OpenMapTiles Data from OpenStreetMap"
# Rate limit (Nogat DEV-15.9): requests of one client address (API calls and pages; static
# files not counted) in a window of seconds; above it 429 with Retry-After
OBSERWATOR_REQUEST_LIMIT=300
OBSERWATOR_REQUEST_WINDOW=60
# Hydrolog's program for `analyses build` and for the choices of a person the GUI computes
# on request (a command line, split like a shell's); unset: `hydrolog` on PATH. The GUI
# looks for it once when it starts; without a program it shows only the stored results.
# OBSERWATOR_HYDROLOG_COMMAND=
# Behind a reverse proxy, set uvicorn's own variable FORWARDED_ALLOW_IPS to the proxy's
# address (default 127.0.0.1,::1), so the rate limit counts clients, not the proxy.
# The app menu's addresses ([nogat.gui]) and the operator of a public deployment
# ([nogat.operator]) are tables of nogat.toml only, not variables (docs/USAGE.md, "GUI").
