{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Obserwator/schemas/obserwator-stations-export-1.schema.json",
  "title": "obserwator-stations-export/1",
  "description": "The stations of the current station catalogs exported by `obserwator stations export --format geojson` (ADR-014): an RFC 7946 FeatureCollection whose foreign members name the catalogs and series read and carry the providers' licences and attribution lines (ADR-012). Every station is a Feature, a Point or no geometry, with the catalog's properties, its provider and the series that hold it. Unknown fields are allowed: adding optional fields keeps the version.",
  "type": "object",
  "required": ["type", "schema", "catalogs", "attribution", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "schema": {"const": "obserwator-stations-export/1"},
    "catalogs": {
      "description": "Every catalog read, one per provider in registry order",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/catalog"}
    },
    "series": {
      "description": "The current series read for the features' series (absent without series)",
      "type": "array",
      "items": {"$ref": "#/$defs/series_version"}
    },
    "attribution": {"$ref": "#/$defs/lines"},
    "terms_notice": {"$ref": "#/$defs/lines"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "not": {
    "description": "RFC 7946 section 7.1: members a FeatureCollection must not contain",
    "anyOf": [
      {"required": ["coordinates"]},
      {"required": ["geometries"]},
      {"required": ["geometry"]},
      {"required": ["properties"]}
    ]
  },
  "$defs": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "station_code": {
      "type": "string",
      "pattern": "^([0-9]{9}|0-[0-9]{1,5}-[0-9]{1,5}-[0-9A-Z]{1,16})$"
    },
    "dataset": {
      "type": "string",
      "pattern": "^[a-z]{2}\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
    },
    "license": {
      "type": "object",
      "required": ["id", "url", "terms_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "terms_url": {"type": ["string", "null"], "pattern": "^https://"}
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "provider",
        "dataset",
        "version",
        "label",
        "downloaded_at",
        "stations",
        "license",
        "attribution"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset": {"$ref": "#/$defs/dataset"},
        "version": {
          "description": "The catalog version read, its directory relative to the root",
          "type": "string",
          "pattern": "^stations/versions/([a-z][a-z0-9_]*/)?[^/]+_[0-9a-f]{8}$"
        },
        "label": {"description": "The version label", "type": ["string", "null"]},
        "downloaded_at": {
          "description": "When the catalog was built, UTC",
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "stations": {
          "description": "The number of its stations in the export",
          "type": "integer",
          "minimum": 0
        },
        "license": {"$ref": "#/$defs/license"},
        "attribution": {
          "description": "The catalog's lines: the provider's formula, the processed mark and, with locations of hydro.imgw.pl, its line",
          "$ref": "#/$defs/lines"
        },
        "terms_notice": {"$ref": "#/$defs/lines"}
      }
    },
    "series_version": {
      "type": "object",
      "required": ["provider", "dataset", "version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset": {"$ref": "#/$defs/dataset"},
        "version": {
          "type": "string",
          "pattern": "^series/versions/[a-z][a-z0-9_]*/[^/]+_[0-9a-f]{8}$"
        }
      }
    },
    "holding": {
      "description": "What a series holds of the station: the first and last date with a value and the variables with values",
      "type": "object",
      "required": ["first", "last", "variables"],
      "properties": {
        "first": {"type": ["string", "null"], "format": "date"},
        "last": {"type": ["string", "null"], "format": "date"},
        "variables": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {
          "description": "WGS 84 longitude and latitude (RFC 7946 section 3.1.1)",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "items": {"type": "number"}
        }
      },
      "not": {
        "description": "RFC 7946 section 7.1: members a Geometry must not contain",
        "anyOf": [
          {"required": ["geometry"]},
          {"required": ["properties"]},
          {"required": ["features"]}
        ]
      }
    },
    "feature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"$ref": "#/$defs/station_code"},
        "geometry": {
          "description": "The station's location; null without one",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/point"}]
        },
        "properties": {
          "type": "object",
          "required": ["station_code", "kind", "name", "provider"],
          "properties": {
            "station_code": {"$ref": "#/$defs/station_code"},
            "kind": {"enum": ["hydro", "meteo"]},
            "name": {"type": ["string", "null"]},
            "provider": {"type": "string", "minLength": 1},
            "series": {
              "description": "Per dataset key, the current series that hold the station (absent without series)",
              "type": "object",
              "propertyNames": {"$ref": "#/$defs/dataset"},
              "additionalProperties": {"$ref": "#/$defs/holding"}
            }
          }
        }
      },
      "not": {
        "description": "RFC 7946 section 7.1: members a Feature must not contain",
        "anyOf": [
          {"required": ["coordinates"]},
          {"required": ["geometries"]},
          {"required": ["features"]}
        ]
      }
    }
  }
}
