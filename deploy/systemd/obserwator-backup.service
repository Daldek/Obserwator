# Obserwator's backup: a weekly snapshot of both roots linked to the one before,
# the first of each month a full copy with its restore test (obserwator-backup.sh).
# Writes the target and its records to Obserwator's log directory; the roots are read.
# A template of Obserwator's deployment guide (docs/USAGE.md "Backups"; Nogat plan
# 2026-11-16-operational-series, step A4): replace every @NAME@ and copy it to
# ~/.config/systemd/user/.

[Unit]
Description=Obserwator backup: weekly snapshot or monthly full copy of the raw and data roots
Documentation=https://github.com/Daldek/Obserwator/blob/main/docs/USAGE.md#backups

[Service]
Type=oneshot
Environment=OBSERWATOR=@OBSERWATOR@
Environment=OBSERWATOR_STATE_DIR=@STATE_DIR@
ExecStart=@DEPLOY_DIR@/obserwator-backup.sh --raw-root @RAW_ROOT@ --data-root @DATA_ROOT@ --target @BACKUP_TARGET@
# Confinement (Nogat install contract, rule 10, units). PrivateTmp, ProtectHome,
# ProtectSystem and ReadWritePaths need unprivileged user namespaces in a user unit
# (present on Debian 13 with systemd 257); every path of ReadWritePaths must exist.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=@BACKUP_TARGET@ @STATE_DIR@/obserwator/logs
# A user unit cannot apply these; a system unit names the account it runs as:
#User=obserwator
#Group=obserwator
