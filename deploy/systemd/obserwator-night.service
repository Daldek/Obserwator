# Obserwator's night: the harvest of hydro.imgw.pl's hourly series until 05:00,
# then of ČHMÚ's recent day files until 06:30, each from the day after its last
# whole harvest (at most 40 days back), then the sealing of every other capture
# dataset's closed UTC days. O4 adds the series build of the months touched.
# A template of Obserwator's deployment guide (docs/USAGE.md "Timers"; Nogat plan
# 2026-11-16-operational-series, step A2): replace every @NAME@ and copy it to
# ~/.config/systemd/user/.

[Unit]
Description=Obserwator night: harvests of the operational series and sealing of the captures
Documentation=https://github.com/Daldek/Obserwator/blob/main/docs/USAGE.md#timers

[Service]
Type=oneshot
Environment=OBSERWATOR=@OBSERWATOR@
Environment=OBSERWATOR_RAW_ROOT=@RAW_ROOT@
Environment=OBSERWATOR_ROOT=@DATA_ROOT@
Environment=OBSERWATOR_STATE_DIR=@STATE_DIR@
ExecStart=@DEPLOY_DIR@/obserwator-jobs.sh night
# Confinement (Nogat install contract, rule 10, units). PrivateTmp, ProtectHome,
# ProtectSystem and ReadWritePaths need unprivileged user namespaces in a user unit
# (present on Debian 13 with systemd 257); every path of ReadWritePaths must exist.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=@RAW_ROOT@ @DATA_ROOT@ @STATE_DIR@/obserwator
# A user unit cannot apply these; a system unit names the account it runs as:
#User=obserwator
#Group=obserwator
